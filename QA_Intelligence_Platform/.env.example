# ── QA Intelligence Platform — Environment Variables ─────────────────────────
# Copy to .env and fill in your values. Never commit .env.

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Embeddings (BAAI/bge-m3 via HuggingFace or local) ────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu                  # cpu | cuda | mps
RERANKER_MODEL=BAAI/bge-reranker-large

# ── LLM Providers (at least one required) ────────────────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=

# ── Neo4j (Knowledge Graph — optional Phase 2) ───────────────────────────────
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_min32chars!!
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Redis (cache + job queue) ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./qa_platform.db
# For production: postgresql://user:password@host:5432/qa_platform

# ── API Security ──────────────────────────────────────────────────────────────
API_KEY=                              # Leave empty for dev (open access)

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_DISABLED=false             # Set true in tests

# ── JIRA Integration ──────────────────────────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── GitHub Integration ────────────────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ── Azure DevOps ──────────────────────────────────────────────────────────────
AZURE_DEVOPS_ORG=
AZURE_DEVOPS_PAT=

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100
