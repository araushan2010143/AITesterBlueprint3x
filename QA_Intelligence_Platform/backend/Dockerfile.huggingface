FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential curl git \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip setuptools wheel

WORKDIR /app

# Build context = backend/ (HF Space repo root)
# so COPY paths are relative to backend/ — no prefix needed
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake models into the image — zero download at cold start
RUN python - <<'EOF'
from huggingface_hub import snapshot_download
print("Downloading BAAI/bge-m3 ...")
snapshot_download("BAAI/bge-m3")
print("Downloading BAAI/bge-reranker-large ...")
snapshot_download("BAAI/bge-reranker-large")
print("Models cached.")
EOF

COPY . .

EXPOSE 8000
CMD uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}
