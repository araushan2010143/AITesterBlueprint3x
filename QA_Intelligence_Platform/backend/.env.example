# Copy this file to .env and fill in your values
# Required: at least GROQ_API_KEY

# ── Embeddings ────────────────────────────────────────────────────────────────
# HF_API_KEY activates HFInferenceEmbedder (BAAI/bge-m3 via API, 1024-dim, zero local RAM)
# Recommended for free-tier deployments. Free token: huggingface.co/settings/tokens
HF_API_KEY=hf_...

# ── LLM Providers ─────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=
COHERE_API_KEY=
GEMINI_API_KEY=

# ── Qdrant (pick ONE mode) ─────────────────────────────────────────────────────
# Option A — Qdrant Cloud (recommended for production, free at cloud.qdrant.io)
QDRANT_URL=https://xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_LOCAL_PATH=

# Option B — Embedded local (dev only, data lost on server restart)
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_LOCAL_PATH=./qdrant_storage

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
FILE_REGISTRY_DB=./file_registry.db
DATABASE_URL=sqlite:///./qa_platform.db

# ── Optional integrations ─────────────────────────────────────────────────────
NEO4J_URI=
REDIS_URL=redis://localhost:6379/0
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
