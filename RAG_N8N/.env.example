# Self-hosted n8n environment variables
# Copy this to .env and fill in your values

# Your server's public URL (e.g. https://n8n.yourdomain.com or Railway URL)
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# API Keys — add these as credentials inside n8n UI, not here
# OPENAI_API_KEY=sk-...          → n8n Credentials > OpenAI
# PINECONE_API_KEY=pc-...        → n8n Credentials > Pinecone
# GROQ_API_KEY=gsk_...           → n8n Credentials > Groq
