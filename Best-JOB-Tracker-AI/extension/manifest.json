{
  "manifest_version": 3,
  "name": "Best JOB Tracker AI",
  "version": "1.0.0",
  "description": "One-click job capture from LinkedIn, Naukri, and Wellfound — powered by Best JOB Tracker AI",

  "key": "",

  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://best-job-tracker-ai.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://best-job-tracker-ai.vercel.app/*",
      "http://localhost:3000/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/jobs/*",
        "*://linkedin.com/jobs/*",
        "*://www.naukri.com/*",
        "*://naukri.com/*",
        "*://wellfound.com/jobs/*",
        "*://angel.co/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "158470437418-4ls2bm2hof1nteaq8q3jk441ob99sh39.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile"
    ]
  }
}