{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "User",
  "type": "object",
  "required": ["id", "email"],
  "properties": {
    "id":       { "type": ["integer", "string"] },
    "email":    { "type": "string", "format": "email" },
    "username": { "type": "string" },
    "name":     { "type": "string" },
    "role": {
      "type": "string",
      "enum": ["admin", "user", "guest"]
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
