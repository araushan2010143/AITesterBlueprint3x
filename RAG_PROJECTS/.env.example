# ─── Pinecone (free at pinecone.io) ──────────────────────────────────────────
# Sign up → Create a Project → API Keys → copy the key
PINECONE_API_KEY=pc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the default index name (auto-created on first ingest)
PINECONE_INDEX_NAME=rag-explorer

# ─── Nomic Embeddings (free at atlas.nomic.ai) ───────────────────────────────
# Sign up → Settings → API Keys → Generate key
NOMIC_API_KEY=nk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Groq LLM (free at console.groq.com) ─────────────────────────────────────
# Sign up → API Keys → Create key
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Optional overrides ───────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text-v1.5
GROQ_MODEL=llama-3.3-70b-versatile
