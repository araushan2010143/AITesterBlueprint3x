# ── Required ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Nomic Embeddings (Option A: Nomic API — free at atlas.nomic.ai) ───
NOMIC_API_KEY=nk-your_nomic_api_key_here

# ── Paths ─────────────────────────────────────────────────────────────
DATA_DIR=../data/data
CHROMA_DIR=../chroma
COLLECTION_NAME=vwo_prd

# ── Defaults (optional — all have sensible defaults) ──────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=4
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=nomic-embed-text-v1.5
